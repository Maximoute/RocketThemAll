# Install as /srv/rocketthemall-dev/shared/.env.development on the VPS.
# Every credential must differ from production.
RTA_ENVIRONMENT=development
POSTGRES_USER=rta_dev
POSTGRES_PASSWORD=replace-with-a-random-development-password
POSTGRES_DB=rta_dev
MINIO_ROOT_USER=rta_dev_root
MINIO_ROOT_PASSWORD=replace-with-a-random-development-root-password
S3_ACCESS_KEY=rta_dev_app
S3_SECRET_KEY=replace-with-a-random-development-s3-secret
NEXTAUTH_SECRET=replace-with-a-random-development-nextauth-secret

# Dedicated Discord OAuth application with exactly this callback:
# https://dev.rocketthemall.com/api/auth/callback/discord
DISCORD_CLIENT_ID_DEV=
DISCORD_CLIENT_SECRET_DEV=
RTA_DEVELOPMENT_ADMIN_DISCORD_ID=
