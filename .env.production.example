# Copy to .env.production. Never commit the populated file.
POSTGRES_DB=rta
POSTGRES_USER=rta
POSTGRES_PASSWORD=replace-with-a-long-random-password

MINIO_ROOT_USER=replace-with-a-random-access-key
MINIO_ROOT_PASSWORD=replace-with-a-long-random-secret

DISCORD_TOKEN=replace-me
DISCORD_CLIENT_ID=replace-me
DISCORD_CLIENT_SECRET=replace-me
DISCORD_GUILD_ID=
DISCORD_ADMIN_ROLE_ID=

NEXTAUTH_SECRET=replace-with-at-least-32-random-bytes
NEXTAUTH_URL=https://rta.example.com
PUBLIC_BASE_URL=https://rta.example.com

# Keep false until the Stripe webhook, prices, tax setup and legal identity
# have all been verified in test mode.
RTA_PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX_ENABLED=false
STRIPE_PRICE_VIP_MONTHLY=
STRIPE_PRICE_FOUNDER_MONTHLY=
STRIPE_PRICE_CREDITS_1000=
STRIPE_PRICE_CREDITS_12000=

# Discord Premium Apps products created in Developer Portal.
DISCORD_MONETIZATION_ENABLED=false
DISCORD_SKU_VIP_MONTHLY=
DISCORD_SKU_FOUNDER_MONTHLY=
DISCORD_SKU_CREDITS_1000=
DISCORD_SKU_CREDITS_12000=

# Public legal identity. Complete every applicable field before production.
LEGAL_PUBLISHER_NAME=
LEGAL_PUBLISHER_STATUS=
LEGAL_PUBLISHER_ADDRESS=
LEGAL_PUBLISHER_EMAIL=
LEGAL_PUBLISHER_PHONE=
LEGAL_ENTERPRISE_NUMBER=
LEGAL_VAT_NUMBER=
LEGAL_PUBLICATION_DIRECTOR=
LEGAL_DATA_CONTROLLER_NAME=
LEGAL_PRIVACY_EMAIL=
LEGAL_HOST_NAME=
LEGAL_HOST_ADDRESS=
LEGAL_HOST_WEBSITE=

TMDB_API_KEY=
RAWG_API_KEY=
