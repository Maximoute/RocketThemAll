DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_SPAWN_CHANNEL_ID=
ADMIN_ROLE_ID=

# Development Compose credentials. Production uses .env.production and
# requires distinct random secrets.
POSTGRES_USER=collector
POSTGRES_PASSWORD=collector
POSTGRES_DB=collector
DATABASE_URL=postgresql://collector:collector@postgres:5432/collector

S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=card-images
S3_PUBLIC_URL=http://localhost:9000/card-images

# Pop Culture import keys
TMDB_API_KEY=your_key_here
RAWG_API_KEY=your_key_here

NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
API_BASE_URL=http://api:4000

# Payments stay disabled until the legal identity, VAT/tax settings and
# provider products are configured. Never expose STRIPE_* secrets to the client.
RTA_PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX_ENABLED=false
STRIPE_PRICE_VIP_MONTHLY=
STRIPE_PRICE_FOUNDER_MONTHLY=
STRIPE_PRICE_CREDITS_1000=
STRIPE_PRICE_CREDITS_12000=

# Discord Premium Apps SKU ids are public snowflakes, not secrets.
DISCORD_MONETIZATION_ENABLED=false
DISCORD_SKU_VIP_MONTHLY=
DISCORD_SKU_FOUNDER_MONTHLY=
DISCORD_SKU_CREDITS_1000=
DISCORD_SKU_CREDITS_12000=

# Public legal identity. Required before a Belgian production launch.
LEGAL_PUBLISHER_NAME=
LEGAL_PUBLISHER_STATUS=
LEGAL_PUBLISHER_ADDRESS=
LEGAL_PUBLISHER_EMAIL=
LEGAL_PUBLISHER_PHONE=
LEGAL_ENTERPRISE_NUMBER=
LEGAL_VAT_NUMBER=
LEGAL_PUBLICATION_DIRECTOR=
LEGAL_DATA_CONTROLLER_NAME=
LEGAL_PRIVACY_EMAIL=
LEGAL_HOST_NAME=
LEGAL_HOST_ADDRESS=
LEGAL_HOST_WEBSITE=

# Rocket League importer image enrichment (real images from Rocket League Fandom)
ROCKET_REAL_IMAGES=true
ROCKET_FANDOM_API_URL=https://rocketleague.fandom.com/api.php
ROCKET_IMAGE_TIMEOUT_MS=5000
ROCKET_IMAGE_SEARCH_FALLBACK_LIMIT=5000
ROCKET_SYNC_IMAGES_ON_BOOT=true
ROCKET_IMAGE_SYNC_LIMIT=10000
