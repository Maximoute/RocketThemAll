{
  "name": "@rta/auth",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./api-auth": {
      "types": "./dist/api-auth.d.ts",
      "import": "./dist/api-auth.js"
    },
    "./web-auth": {
      "types": "./dist/web-auth.d.ts",
      "import": "./dist/web-auth.js"
    },
    "./bot-auth": {
      "types": "./dist/bot-auth.d.ts",
      "import": "./dist/bot-auth.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "dependencies": {
    "@rta/database": "1.0.0",
    "next": "15.5.21",
    "next-auth": "4.24.15"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.7.4"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs"
  }
}
