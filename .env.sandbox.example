# Optional local overrides for docker-compose.yml.
# Copy to .env.sandbox only when OAuth Discord or custom ports are needed.
# This file is for the local sandbox only; never reuse production values.

RTA_SANDBOX_PORT=3100
RTA_SANDBOX_API_PORT=4100
RTA_SANDBOX_POSTGRES_PORT=55432
RTA_SANDBOX_MINIO_PORT=59000
RTA_SANDBOX_MINIO_CONSOLE_PORT=59001

# Optional Discord OAuth application configured with callback:
# http://localhost:3100/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Required only with: npm run sandbox:discord
DISCORD_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ADMIN_ROLE_ID=
