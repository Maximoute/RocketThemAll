{
  "name": "rocket-them-all",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "clean": "node scripts/clean-generated.mjs",
    "build": "npm run clean && npm run build:packages && npm run build:apps",
    "build:packages": "npm run -w @rta/shared build && npm run -w @rta/game-engine build && npm run -w @rta/database prisma:generate && npm run -w @rta/database build && npm run -w @rta/auth build && npm run -w @rta/services build",
    "build:apps": "npm run -w @rta/api build && npm run -w @rta/bot build && npm run -w @rta/worker build && npm run -w @rta/web build",
    "dev": "npm run build:packages && concurrently -k -n api,bot,worker,web \"npm run -w @rta/api dev\" \"npm run -w @rta/bot dev\" \"npm run -w @rta/worker dev\" \"npm run -w @rta/web dev\"",
    "sandbox:up": "docker compose up --build -d",
    "sandbox:down": "docker compose down --remove-orphans",
    "sandbox:reset": "docker compose down --volumes --remove-orphans",
    "sandbox:status": "docker compose ps",
    "sandbox:logs": "docker compose logs --follow --tail=200",
    "sandbox:media": "docker compose --profile tools run --rm media-sync",
    "sandbox:full": "docker compose --profile full up --build -d",
    "sandbox:discord": "docker compose --env-file .env.sandbox --profile discord up --build -d bot",
    "test": "npm run -ws --if-present test",
    "test:engine": "npm run -w @rta/game-engine test",
    "lint": "npm run build:packages && npm run lint:workspaces",
    "lint:workspaces": "npm run -ws lint",
    "prisma:generate": "npm run -w @rta/database prisma:generate",
    "prisma:validate": "node scripts/prisma-validate.mjs",
    "prisma:migrate:deploy": "prisma migrate deploy --schema packages/database/prisma/schema.prisma",
    "prisma:migrate": "npm run -w @rta/database prisma:migrate",
    "prisma:seed": "npm run -w @rta/database prisma:seed",
    "import:vault": "npm run -w @rta/database prisma:import-vault",
    "audit:vault": "node scripts/audit-vault.mjs",
    "validate:context": "node scripts/validate-context.mjs",
    "security:secrets": "node scripts/scan-secrets.mjs",
    "check": "npm run security:secrets && npm run lint && npm test && npm run prisma:validate && npm run validate:context && npm run build && npm audit --audit-level=high",
    "make-admin": "tsx scripts/make-admin.ts"
  },
  "devDependencies": {
    "concurrently": "9.2.5",
    "nanoid": "3.3.18",
    "postcss-selector-parser": "6.1.5",
    "prisma": "5.22.0",
    "source-map-js": "1.2.2",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@prisma/client": "5.22.0"
  },
  "optionalDependencies": {
    "@next/swc-linux-x64-gnu": "15.5.29",
    "@next/swc-linux-x64-musl": "15.5.29",
    "@rolldown/binding-linux-x64-gnu": "1.2.19",
    "@rolldown/binding-wasm32-wasi": "1.2.19"
  },
  "overrides": {
    "body-parser": "1.20.9",
    "browserslist": "4.28.9",
    "form-data": "4.0.6",
    "nanoid": "3.3.18",
    "next": "15.5.29",
    "postcss": "8.5.23",
    "postcss-selector-parser": "6.1.5",
    "proxy-addr": "2.0.8",
    "qs": "6.17.1",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "ws": "8.21.1"
  }
}
